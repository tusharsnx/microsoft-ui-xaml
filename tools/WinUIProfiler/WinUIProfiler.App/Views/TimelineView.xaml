<UserControl
    x:Class="WinUIProfiler.App.Views.TimelineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinUIProfiler.App.ViewModels"
    KeyDown="TimelineView_KeyDown"
    IsTabStop="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="XamlColorBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="XamlFillBrush" Color="#350078D4" />
                    <SolidColorBrush x:Key="CompositionColorBrush" Color="#8764B8" />
                    <SolidColorBrush x:Key="CompositionFillBrush" Color="#358764B8" />
                    <SolidColorBrush x:Key="OtherColorBrush" Color="#D83B01" />
                    <SolidColorBrush x:Key="OtherFillBrush" Color="#35D83B01" />
                    <SolidColorBrush x:Key="TrackBackgroundBrush" Color="#08FFFFFF" />
                    <SolidColorBrush x:Key="RulerBackgroundBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="SplitterHandleBrush" Color="#20FFFFFF" />
                    <SolidColorBrush x:Key="SplitterHoverBrush" Color="#500078D4" />
                    <SolidColorBrush x:Key="SelectionWindowFill" Color="#280078D4" />
                    <SolidColorBrush x:Key="SelectionHandleBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="DimCoverBrush" Color="#60000000" />
                    <SolidColorBrush x:Key="FrameRequestMarkerBrush" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="FrameRequestDelayedMarkerBrush" Color="#FFFF4343" />
                    <SolidColorBrush x:Key="FrameCommitMarkerBrush" Color="#27C380" />
                    <AcrylicBrush x:Key="HoverPopupBackground" TintColor="#202020" TintOpacity="0.8" FallbackColor="#202020" />
                    <SolidColorBrush x:Key="HoverPopupBorder" Color="#4A4A4A" />
                    <AcrylicBrush x:Key="SidePanelBackground" TintColor="#1E1E1E" TintOpacity="0.8" FallbackColor="#1E1E1E" />
                    <SolidColorBrush x:Key="SidePanelBorder" Color="#404040" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="XamlColorBrush" Color="#005A9E" />
                    <SolidColorBrush x:Key="XamlFillBrush" Color="#250078D4" />
                    <SolidColorBrush x:Key="CompositionColorBrush" Color="#6B2D8B" />
                    <SolidColorBrush x:Key="CompositionFillBrush" Color="#258764B8" />
                    <SolidColorBrush x:Key="OtherColorBrush" Color="#A80000" />
                    <SolidColorBrush x:Key="OtherFillBrush" Color="#25D83B01" />
                    <SolidColorBrush x:Key="TrackBackgroundBrush" Color="#06000000" />
                    <SolidColorBrush x:Key="RulerBackgroundBrush" Color="#0C000000" />
                    <SolidColorBrush x:Key="SplitterHandleBrush" Color="#18000000" />
                    <SolidColorBrush x:Key="SplitterHoverBrush" Color="#600078D4" />
                    <SolidColorBrush x:Key="SelectionWindowFill" Color="#200078D4" />
                    <SolidColorBrush x:Key="SelectionHandleBrush" Color="#005A9E" />
                    <SolidColorBrush x:Key="DimCoverBrush" Color="#35000000" />
                    <SolidColorBrush x:Key="FrameRequestMarkerBrush" Color="#50000000" />
                    <SolidColorBrush x:Key="FrameRequestDelayedMarkerBrush" Color="#FFD13438" />
                    <SolidColorBrush x:Key="FrameCommitMarkerBrush" Color="#107C41" />
                    <AcrylicBrush x:Key="HoverPopupBackground" TintColor="#F9F9F9" TintOpacity="0.8" FallbackColor="#F9F9F9" />
                    <SolidColorBrush x:Key="HoverPopupBorder" Color="#D0D0D0" />
                    <AcrylicBrush x:Key="SidePanelBackground" TintColor="#F8F8F8" TintOpacity="0.8" FallbackColor="#F8F8F8" />
                    <SolidColorBrush x:Key="SidePanelBorder" Color="#D4D4D4" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ElementBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorAttentionBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="4,1" />
            </Style>
            <Style x:Key="VisualBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorAccentBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="4,1" />
            </Style>
            <Style x:Key="ElementBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="10" />
            </Style>
            <Style x:Key="VisualBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="10" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid RowSpacing="6" Padding="0,6,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Toolbar -->
            <RowDefinition Height="Auto" /> <!-- Overview Panel -->
            <RowDefinition Height="Auto" /> <!-- Ruler -->
            <RowDefinition Height="*" />    <!-- Tracks -->
        </Grid.RowDefinitions>

        <!-- 0: Toolbar -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="VisibleRangeText" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="EventCountsSummary" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button x:Name="ZoomInButton" Grid.Column="1" ToolTipService.ToolTip="Zoom in (Ctrl+Wheel or Shift++)" Click="ZoomIn_Click">
                <FontIcon Glyph="&#xE71F;" FontSize="12" />
            </Button>
            <Button x:Name="ZoomOutButton" Grid.Column="2" ToolTipService.ToolTip="Zoom out (Ctrl+Wheel or Shift+-)" Click="ZoomOut_Click">
                <FontIcon Glyph="&#xE738;" FontSize="12" />
            </Button>
            <Button x:Name="FitAllButton" x:Uid="TimelineFitAll" Grid.Column="3" Click="FitAll_Click" />
        </Grid>

        <!-- 1: Overview Panel -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10,6">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="56" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header & Legend -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Overview (Event Density)" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Rectangle Width="10" Height="10" Fill="{ThemeResource XamlColorBrush}" RadiusX="2" RadiusY="2" />
                            <TextBlock Text="Xaml" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Rectangle Width="10" Height="10" Fill="{ThemeResource CompositionColorBrush}" RadiusX="2" RadiusY="2" />
                            <TextBlock Text="Composition" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Rectangle Width="10" Height="10" Fill="{ThemeResource OtherColorBrush}" RadiusX="2" RadiusY="2" />
                            <TextBlock Text="Other" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Frame request hint (RequestFrameReason)">
                            <Rectangle Width="2" Height="10" Fill="{ThemeResource FrameRequestMarkerBrush}" RadiusX="1" RadiusY="1" Opacity="0.5" />
                            <TextBlock Text="Frame Request" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Delayed frame request (&gt; 16.66ms or unfulfilled)">
                            <Rectangle Width="2" Height="10" Fill="{ThemeResource FrameRequestDelayedMarkerBrush}" RadiusX="1" RadiusY="1" />
                            <TextBlock Text="Delayed Request (&gt;16.66ms)" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Frame commit (CommitMainDevice)">
                            <Rectangle Width="2" Height="10" Fill="{ThemeResource FrameCommitMarkerBrush}" RadiusX="1" RadiusY="1" />
                            <TextBlock Text="Frame Commit" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="ClearSelectionButton" x:Uid="TimelineClearSelection" Grid.Column="2"
                            Padding="8,2" FontSize="11" Click="ClearSelection_Click" Visibility="Collapsed" />
                </Grid>

                <!-- Line Plot & Range Shading -->
                <Grid x:Name="OverviewContainer" Grid.Row="1" Background="{ThemeResource TrackBackgroundBrush}"
                      SizeChanged="OverviewContainer_SizeChanged"
                      ManipulationMode="TranslateX,TranslateInertia"
                      ManipulationDelta="Tracks_ManipulationDelta"
                      PointerPressed="Overview_PointerPressed"
                      PointerMoved="Overview_PointerMoved"
                      PointerReleased="Overview_PointerReleased"
                      PointerCaptureLost="Overview_PointerCaptureLost"
                      PointerWheelChanged="Overview_PointerWheelChanged"
                      PointerExited="Overview_PointerExited"
                      DoubleTapped="Overview_DoubleTapped">
                    <!-- Frame Markers (Requests and Commits) -->
                    <Canvas x:Name="OverviewMarkersCanvas" IsHitTestVisible="False">
                        <Path x:Name="OverviewFrameRequestsPath" Stroke="{ThemeResource FrameRequestMarkerBrush}" StrokeThickness="1" Opacity="0.45" />
                        <Path x:Name="OverviewFrameRequestsDelayedPath" Stroke="{ThemeResource FrameRequestDelayedMarkerBrush}" StrokeThickness="1.5" />
                        <Path x:Name="OverviewFrameCommitsPath" Stroke="{ThemeResource FrameCommitMarkerBrush}" StrokeThickness="1.5" />
                    </Canvas>

                    <!-- Graph Paths -->
                    <Canvas x:Name="OverviewPlotCanvas" IsHitTestVisible="False">
                        <Path x:Name="OverviewXamlPath" Stroke="{ThemeResource XamlColorBrush}" StrokeThickness="1.5" />
                        <Path x:Name="OverviewCompPath" Stroke="{ThemeResource CompositionColorBrush}" StrokeThickness="1.5" />
                        <Path x:Name="OverviewOtherPath" Stroke="{ThemeResource OtherColorBrush}" StrokeThickness="1.5" />
                    </Canvas>

                    <!-- Interactive Selection Region Overlay -->
                    <Canvas x:Name="OverviewSelectionCanvas" IsHitTestVisible="False">
                        <!-- Left dim mask -->
                        <Rectangle x:Name="SelDimLeft" Fill="{ThemeResource DimCoverBrush}" Height="56" />
                        <!-- Active selection box -->
                        <Border x:Name="SelWindow" Height="56" Background="{ThemeResource SelectionWindowFill}"
                                BorderBrush="{ThemeResource SelectionHandleBrush}" BorderThickness="1,0" />
                        <!-- Left resize handle -->
                        <Border x:Name="SelLeftHandle" Width="8" Height="56" Background="{ThemeResource SelectionHandleBrush}"
                                Opacity="0.9" CornerRadius="2,0,0,2" />
                        <!-- Right resize handle -->
                        <Border x:Name="SelRightHandle" Width="8" Height="56" Background="{ThemeResource SelectionHandleBrush}"
                                Opacity="0.9" CornerRadius="0,2,2,0" />
                        <!-- Right dim mask -->
                        <Rectangle x:Name="SelDimRight" Fill="{ThemeResource DimCoverBrush}" Height="56" />
                    </Canvas>
                </Grid>

                <!-- Start & End time bounds -->
                <Grid Grid.Row="2">
                    <TextBlock x:Name="OverviewStartText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="OverviewEndText" HorizontalAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 2: Ruler -->
        <Border Grid.Row="2" Height="24" Background="{ThemeResource RulerBackgroundBrush}" CornerRadius="4">
            <Canvas x:Name="RulerCanvas" Background="Transparent" SizeChanged="RulerCanvas_SizeChanged"
                    ManipulationMode="TranslateX,TranslateInertia"
                    ManipulationDelta="Tracks_ManipulationDelta"
                    PointerWheelChanged="Ruler_PointerWheelChanged" />
        </Border>

        <!-- 3: Tracks Container -->
        <Grid Grid.Row="3">
            <ScrollViewer x:Name="TracksScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TracksPanel" Spacing="4"
                            ManipulationMode="System,TranslateX,TranslateInertia"
                            ManipulationDelta="Tracks_ManipulationDelta"
                            PointerWheelChanged="Tracks_PointerWheelChanged">
                    <!-- Track 0: Frames (Requests & Commits) -->
                    <Grid x:Name="FramesTrackContainer">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2" VerticalAlignment="Center">
                            <Rectangle Width="4" Height="14" Fill="{ThemeResource FrameCommitMarkerBrush}" RadiusX="2" RadiusY="2" />
                            <TextBlock Text="Frames (Requests &amp; Commits)" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock x:Name="FramesCountText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Row="1" x:Name="FramesTrackBorder" Height="36" MinHeight="36" MaxHeight="36"
                                Background="{ThemeResource TrackBackgroundBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                            <Canvas x:Name="FramesCanvas"
                                    Height="34"
                                    Background="Transparent"
                                    ManipulationMode="System,TranslateX,TranslateInertia"
                                    ManipulationDelta="Tracks_ManipulationDelta"
                                    PointerWheelChanged="Tracks_PointerWheelChanged"
                                    SizeChanged="TrackCanvas_SizeChanged"
                                    PointerPressed="Track_PointerPressed"
                                    PointerMoved="Track_PointerMoved"
                                    PointerReleased="Track_PointerReleased"
                                    PointerCaptureLost="Track_PointerCaptureLost"
                                    PointerExited="Track_PointerExited" />
                        </Border>
                    </Grid>

                    <!-- Dynamic Thread Tracks -->
                    <StackPanel x:Name="ThreadTracksPanel" Spacing="6" />
                </StackPanel>
            </ScrollViewer>

            <!-- Floating Hover Card Overlay -->
            <Canvas x:Name="HoverOverlayCanvas" IsHitTestVisible="False">
                <Border x:Name="HoverHighlight"
                        BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed"
                        IsHitTestVisible="False" />

                <Border x:Name="HoverCard"
                        Visibility="Collapsed"
                        Background="{ThemeResource HoverPopupBackground}"
                        BorderBrush="{ThemeResource HoverPopupBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        MaxWidth="360"
                        IsHitTestVisible="False">
                    <StackPanel Spacing="5">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="HoverTitle"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2"
                                       TextWrapping="Wrap" />
                            <Border x:Name="HoverBucketBadge" Grid.Column="1"
                                    CornerRadius="3" Padding="5,1" VerticalAlignment="Top">
                                <TextBlock x:Name="HoverBucketText" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="HoverDuration"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock x:Name="HoverTimeSpan"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="HoverMetaThread"
                                       FontSize="10"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="HoverMetaProvider" Grid.Column="1"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Canvas>

            <!-- Floating Event Details Side Panel -->
            <Border x:Name="InspectorBorder"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="380"
                    Margin="0,4,8,8"
                    Padding="14,12"
                    Background="{ThemeResource SidePanelBackground}"
                    BorderBrush="{ThemeResource SidePanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="*" />    <!-- Scrollable content -->
                    </Grid.RowDefinitions>

                    <!-- Header with close button -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border x:Name="DetailBucketBadge" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailBucketText" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                </Border>
                                <TextBlock x:Name="DetailTitleText" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="DetailDurationText" Style="{ThemeResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock x:Name="DetailMetaText" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" Padding="6,3" Click="InspectorClose_Click" ToolTipService.ToolTip="Close inspector">
                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                        </Button>
                    </Grid>

                    <!-- Scrollable Details & Mentioned Objects -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <!-- Details and Fields -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Details &amp; Fields" Style="{ThemeResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border Background="{ThemeResource TrackBackgroundBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <TextBlock x:Name="DetailFieldsText" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                               FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" />
                                </Border>
                            </StackPanel>

                            <!-- Mentioned Objects -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Mentioned Objects" Style="{ThemeResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border Background="{ThemeResource TrackBackgroundBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="8,6">
                                    <ItemsControl x:Name="DetailObjectsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ObjectLink">
                                                <Grid ColumnSpacing="6" Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource ElementBadgeStyle}" Visibility="{x:Bind IsElement}">
                                                        <TextBlock Text="{x:Bind KindText}" Style="{StaticResource ElementBadgeTextStyle}" />
                                                    </Border>
                                                    <Border Style="{StaticResource VisualBadgeStyle}" Visibility="{x:Bind IsVisual}">
                                                        <TextBlock Text="{x:Bind KindText}" Style="{StaticResource VisualBadgeTextStyle}" />
                                                    </Border>
                                                    <HyperlinkButton Grid.Column="1" Tag="{x:Bind Mention}" Padding="0,1" Click="ObjectLink_Click">
                                                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                                                    </HyperlinkButton>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Empty / Status State -->
        <Border x:Name="StatusNoticeBorder" Grid.Row="2" Grid.RowSpan="2"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="20,12" Visibility="Collapsed">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <ProgressRing x:Name="StatusProgressRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusNoticeText" TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
