<UserControl
    x:Class="InputTimingSample.TimelineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="TimelineRoot" SizeChanged="OnTimelineSizeChanged">
        <Grid.RowDefinitions>
            <!-- 0: Controls and Legends -->
            <RowDefinition Height="Auto" />
            <!-- 1: Timeline Canvas Area -->
            <RowDefinition Height="*" />
            <!-- 2: Hover Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Filter Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical" Spacing="2">
                <TextBlock x:Name="TimelineTitleBlock" Text="Unified Input, Render &amp; Frame Timeline" FontWeight="SemiBold" FontSize="14" />
                <TextBlock x:Name="TimelineSubtitleBlock" Text="Chronological alignment of Win32 window receipt, RichEdit input, layout passes, viewport scrolls, and compositor frames. Ctrl+Scroll to zoom, drag to pan, hover to inspect."
                           FontSize="11" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="14" VerticalAlignment="Center">
                <Button x:Name="ResetZoomButton" Content="⟲ Reset Zoom" Visibility="Collapsed"
                        Click="OnResetZoomClicked" FontSize="11" Height="28" Padding="8,2" />

                <ComboBox x:Name="TimeWindowCombo" SelectedIndex="0" SelectionChanged="OnTimeWindowChanged" FontSize="11" Height="28" Padding="8,2">
                    <ComboBoxItem Content="Full Session" />
                    <ComboBoxItem Content="Last 5 Seconds" />
                    <ComboBoxItem Content="Last 10 Seconds" />
                </ComboBox>

                <CheckBox x:Name="ShowPointerMovesCheckBox" Content="Show PointerMoves" IsChecked="True"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged" FontSize="11" />

                <!-- Unified Legend Badges -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#8B5CF6" Stroke="#EDE9FE" StrokeThickness="1" />
                        <TextBlock Text="Frames" FontSize="11" Foreground="#8B5CF6" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#3B82F6" Stroke="#DBEAFE" StrokeThickness="1" />
                        <TextBlock Text="Layout" FontSize="11" Foreground="#3B82F6" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#14B8A6" Stroke="#CCFBF1" StrokeThickness="1" />
                        <TextBlock Text="Viewport" FontSize="11" Foreground="#14B8A6" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#10B981" Stroke="#D1FAE5" StrokeThickness="1" />
                        <TextBlock Text="Content" FontSize="11" Foreground="#10B981" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#F59E0B" Stroke="#FEF3C7" StrokeThickness="1" />
                        <TextBlock Text="Key/Char" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#06B6D4" Stroke="#CFFAFE" StrokeThickness="1" />
                        <TextBlock Text="Pointer" FontSize="11" Foreground="#06B6D4" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#F43F5E" Stroke="#FFE4E6" StrokeThickness="1" />
                        <TextBlock Text="VisualState" FontSize="11" Foreground="#F43F5E" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Main Timeline Board: Left Swimlane Headers (7 Tracks) + Right Canvas Area -->
        <Border Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
                PointerWheelChanged="OnTimelinePointerWheelChanged">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="135" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Lane Headers on Left -->
                <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0"
                        Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                    <Grid x:Name="LaneLabelsGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" /> <!-- 0: Time Ruler Header -->
                            <RowDefinition Height="*" />  <!-- 1: Frames & Composition Lane -->
                            <RowDefinition Height="*" />  <!-- 2: Layout Passes Lane -->
                            <RowDefinition Height="*" />  <!-- 3: Viewport & Scroll Lane -->
                            <RowDefinition Height="*" />  <!-- 4: Content & Selection Lane -->
                            <RowDefinition Height="*" />  <!-- 5: Keyboard & Text Lane -->
                            <RowDefinition Height="*" />  <!-- 6: Pointer Input Lane -->
                            <RowDefinition Height="*" />  <!-- 7: Visual State Lane -->
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                            <TextBlock Text="TIME RULER" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" />
                        </Border>

                        <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Frames &amp; Comp" FontSize="11" FontWeight="SemiBold" Foreground="#8B5CF6" />
                                <TextBlock Text="Compositor commit" FontSize="9" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Layout Passes" FontSize="11" FontWeight="SemiBold" Foreground="#3B82F6" />
                                <TextBlock Text="Size &amp; LayoutUpdated" FontSize="9" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Viewport" FontSize="11" FontWeight="SemiBold" Foreground="#14B8A6" />
                                <TextBlock Text="BringIntoView &amp; Scroll" FontSize="9" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Content" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                                <TextBlock Text="Text &amp; Selection" FontSize="9" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="5" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Key &amp; Char Input" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" />
                                <TextBlock Text="Char &amp; KeyDown" FontSize="9" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Pointer Input" FontSize="11" FontWeight="SemiBold" Foreground="#06B6D4" />
                                <TextBlock Text="Down, Up &amp; Moves" FontSize="9" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="7" Padding="8,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Visual State" FontSize="11" FontWeight="SemiBold" Foreground="#F43F5E" />
                                <TextBlock Text="GotFocus &amp; LostFocus" FontSize="9" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Interactive Timeline Canvas on Right -->
                <Canvas x:Name="TimelineCanvas" Grid.Column="1" Background="Transparent"
                        PointerMoved="OnCanvasPointerMoved" PointerExited="OnCanvasPointerExited"
                        PointerPressed="OnCanvasPointerPressed" PointerReleased="OnCanvasPointerReleased"
                        PointerCaptureLost="OnCanvasPointerCaptureLost"
                        PointerWheelChanged="OnTimelinePointerWheelChanged">
                    <!-- Dynamic Lane backgrounds, ruler ticks, frames, event markers, crosshair and tooltip rendered via code-behind -->
                </Canvas>
            </Grid>
        </Border>

        <!-- Bottom Hover Info & Summary Bar -->
        <Border Grid.Row="2" Margin="0,6,0,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="HoverStatusText" Grid.Column="0"
                           Text="Hover over any frame or event bar on the timeline to inspect full details"
                           FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" />

                <TextBlock x:Name="TimeRangeSummaryText" Grid.Column="1" Text="Range: --"
                           FontSize="11" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
